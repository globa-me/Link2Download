<Window x:Class="Link2Download.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Link2Download.Windows.App.Converters"
        mc:Ignorable="d"
        Title="Link2Download for Windows"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="760"
        Background="#F2F6FA">
    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:DurationConverter x:Key="DurationConverter" />
        <converters:SpeedConverter x:Key="SpeedConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#D8E4EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="#13324A" />
            <Setter Property="Background" Value="#E9F1F8" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#C8D6E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="28"
                Padding="24"
                Margin="0,0,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F6CBD" Offset="0" />
                    <GradientStop Color="#4AA7DF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Link2Download"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Native Windows downloader for yt-dlp workflows, with persistent history and a strict one-at-a-time queue."
                               Margin="0,6,0,18"
                               Foreground="#EAF5FF"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,12,0"
                                 FontSize="14"
                                 Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Paste &amp; Queue"
                                Command="{Binding PasteAndQueueCommand}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Download"
                                Command="{Binding StartDownloadCommand}" />
                    </Grid>
                </StackPanel>

                <UniformGrid Grid.Column="1"
                             Columns="2"
                             Margin="24,0,0,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" Background="#F7FBFF">
                        <StackPanel>
                            <TextBlock Text="Active" Foreground="#5C748A" />
                            <TextBlock Text="{Binding ActiveCount}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Background="#F7FBFF">
                        <StackPanel>
                            <TextBlock Text="Queued" Foreground="#5C748A" />
                            <TextBlock Text="{Binding QueuedCount}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0" Background="#F7FBFF">
                        <StackPanel>
                            <TextBlock Text="Completed" Foreground="#5C748A" />
                            <TextBlock Text="{Binding CompletedCount}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Background="#F7FBFF">
                        <StackPanel>
                            <TextBlock Text="Failed" Foreground="#5C748A" />
                            <TextBlock Text="{Binding FailedCount}" FontSize="28" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,18"
                Background="#FFF7E7"
                BorderBrush="#F2D98B">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#6A4B00" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,12,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Filters}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedFilter}" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemsSource="{Binding DownloadsView}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,14"
                                        Padding="18"
                                        CornerRadius="18"
                                        Background="#F8FBFE"
                                        BorderBrush="#DCE8F2"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" Foreground="#60758A" Text="{Binding SourceUrl}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="#E5F1FB"
                                                    Padding="10,6"
                                                    CornerRadius="999"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#15466C" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <ProgressBar Margin="0,14,0,10"
                                                     Height="10"
                                                     Maximum="1"
                                                     Value="{Binding Progress}" />

                                        <WrapPanel Margin="0,0,0,10">
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding ServiceName}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding Kind}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding QualityLabel}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding OutputFormat}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding DurationSeconds, Converter={StaticResource DurationConverter}}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding FileSizeBytes, Converter={StaticResource ByteSizeConverter}}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding AverageSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" />
                                            <TextBlock Margin="0,0,18,8" Foreground="#435B72" Text="{Binding UpdatedAt, StringFormat='Updated {0:yyyy-MM-dd HH:mm}'}" />
                                        </WrapPanel>

                                        <TextBlock Margin="0,0,0,10"
                                                   Foreground="#51687D"
                                                   Text="{Binding FilePath}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,0,0,12"
                                                   Foreground="#B12E2E"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ErrorMessage}"
                                                   TextWrapping="Wrap" />

                                        <WrapPanel>
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Open file"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Show in Explorer"
                                                    Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Copy source URL"
                                                    Command="{Binding DataContext.CopySourceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Open source URL"
                                                    Command="{Binding DataContext.OpenSourceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Retry"
                                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Cancel"
                                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource ActionButtonStyle}"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Download Defaults" FontSize="22" FontWeight="Bold" />
                            <TextBlock Margin="0,6,0,12"
                                       Foreground="#5A7287"
                                       Text="These settings are saved automatically to %AppData%\Link2Download\settings.json." />

                            <CheckBox Content="Smart mode"
                                      IsChecked="{Binding Settings.SmartModeEnabled}" />

                            <TextBlock Margin="0,14,0,0" Text="Language" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Language}" />

                            <TextBlock Margin="0,14,0,0" Text="Download type" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding DownloadKinds}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Kind}" />

                            <TextBlock Margin="0,14,0,0" Text="Quality" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding QualityPresets}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Quality}" />

                            <TextBlock Margin="0,14,0,0" Text="Video format" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding VideoFormats}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.VideoFormat}" />

                            <TextBlock Margin="0,14,0,0" Text="Audio format" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AudioFormats}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.AudioFormat}" />

                            <TextBlock Margin="0,14,0,0" Text="Speed limit" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding SpeedLimits}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.SpeedLimit}" />

                            <TextBlock Margin="0,14,0,0" Text="Browser cookies" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding CookieSources}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.CookieSource}" />

                            <CheckBox Content="Download subtitles when available"
                                      IsChecked="{Binding Settings.IncludeSubtitles}" />
                            <CheckBox Content="Download additional audio tracks when available"
                                      IsChecked="{Binding Settings.IncludeAdditionalAudioTracks}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Save Folder" FontSize="22" FontWeight="Bold" />
                            <TextBox Margin="0,12,0,0"
                                     Text="{Binding Settings.SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Content="Choose folder"
                                    Command="{Binding BrowseSaveFolderCommand}" />
                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Content="Reset defaults"
                                    Command="{Binding ResetDefaultsCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Diagnostics" FontSize="22" FontWeight="Bold" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#5A7287"
                                       Text="Expected runtime location: windows/runtime/win-x64/yt-dlp.exe, ffmpeg.exe, ffprobe.exe"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#5A7287"
                                       Text="{Binding LogFilePath}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
