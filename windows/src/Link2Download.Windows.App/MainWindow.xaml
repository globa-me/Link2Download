<Window x:Class="Link2Download.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Link2Download.Windows.App.Converters"
        mc:Ignorable="d"
        Title="Link2Download for Windows"
        Width="1080"
        Height="760"
        MinWidth="780"
        MinHeight="560"
        Background="#EEF3F8">
    <Window.Resources>
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:DurationConverter x:Key="DurationConverter" />
        <converters:SpeedConverter x:Key="SpeedConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="#D7E2EC" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#17324A" />
            <Setter Property="Background" Value="#EAF2F9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1672D6" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#C7D5E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Link2Download" FontSize="22" FontWeight="Bold" Foreground="#17324A" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="#60758A"
                                       Text="Compact Windows downloader for yt-dlp with persistent history and a one-at-a-time queue."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <UniformGrid Grid.Column="1" Columns="4" Margin="0,2,0,0">
                            <Border Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#60758A" Text="Active" />
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ActiveCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#60758A" Text="Queued" />
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding QueuedCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#60758A" Text="Done" />
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding CompletedCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Padding="10,7">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="#60758A" Text="Failed" />
                                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding FailedCount}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,10,8"
                                 Text="{Binding InputUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource ToolButtonStyle}"
                                Content="Paste &amp; Queue"
                                Command="{Binding PasteAndQueueCommand}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Download"
                                Command="{Binding StartDownloadCommand}" />
                    </Grid>

                    <WrapPanel>
                        <ComboBox Width="108"
                                  ItemsSource="{Binding DownloadKinds}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Kind}" />
                        <ComboBox Width="108"
                                  ItemsSource="{Binding QualityPresets}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Quality}" />
                        <ComboBox Width="112"
                                  ItemsSource="{Binding VideoFormats}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.VideoFormat}" />
                        <ComboBox Width="112"
                                  ItemsSource="{Binding AudioFormats}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.AudioFormat}" />
                        <ComboBox Width="132"
                                  ItemsSource="{Binding SpeedLimits}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.SpeedLimit}" />
                        <CheckBox Margin="6,7,14,0"
                                  VerticalAlignment="Center"
                                  Content="Smart mode"
                                  IsChecked="{Binding Settings.SmartModeEnabled}" />
                        <Button Style="{StaticResource ToolButtonStyle}"
                                Content="Choose folder"
                                Command="{Binding BrowseSaveFolderCommand}" />
                        <Button Style="{StaticResource ToolButtonStyle}"
                                Content="Reset"
                                Command="{Binding ResetDefaultsCommand}" />
                    </WrapPanel>

                    <TextBlock Margin="2,0,0,0"
                               FontSize="12"
                               Foreground="#60758A"
                               Text="{Binding Settings.SaveDirectory}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,10"
                    Background="#FFF8E8"
                    BorderBrush="#F2D58B"
                    Padding="12,10">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#6F5200" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Margin="0,0,10,0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1"
                                  Margin="0"
                                  ItemsSource="{Binding Filters}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedFilter}" />
                    </Grid>

                    <TabControl>
                        <TabItem Header="Downloads">
                            <ListBox Margin="0,8,0,0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ItemsSource="{Binding DownloadsView}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="#F8FBFE"
                                                BorderBrush="#DCE8F2"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <Border DockPanel.Dock="Right"
                                                            Background="#E8F1FB"
                                                            Padding="9,4"
                                                            CornerRadius="999"
                                                            Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding StatusMessage}"
                                                                   FontSize="11"
                                                                   Foreground="#16456B"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15"
                                                               Foreground="#17324A"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </DockPanel>

                                                <TextBlock Margin="0,0,0,8"
                                                           FontSize="12"
                                                           Foreground="#60758A"
                                                           Text="{Binding SourceUrl}"
                                                           TextWrapping="Wrap" />

                                                <ProgressBar Margin="0,0,0,8" Height="8" Maximum="1" Value="{Binding Progress}" />

                                                <WrapPanel Margin="0,0,0,8">
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding ServiceName}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding Kind}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding QualityLabel}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding OutputFormat}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding DurationSeconds, Converter={StaticResource DurationConverter}}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding FileSizeBytes, Converter={StaticResource ByteSizeConverter}}" />
                                                    <TextBlock Margin="0,0,12,6" FontSize="12" Foreground="#60758A" Text="{Binding AverageSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" />
                                                </WrapPanel>

                                                <TextBlock Margin="0,0,0,8"
                                                           FontSize="12"
                                                           Foreground="#60758A"
                                                           Text="{Binding FilePath}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,0,0,8"
                                                           FontSize="11"
                                                           Foreground="#B12E2E"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ErrorMessage}"
                                                           TextWrapping="Wrap" />

                                                <WrapPanel>
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Open file"
                                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Show in Explorer"
                                                            Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Copy source URL"
                                                            Command="{Binding DataContext.CopySourceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Open source URL"
                                                            Command="{Binding DataContext.OpenSourceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Retry"
                                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Cancel"
                                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource ActionButtonStyle}"
                                                            Content="Remove"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Preferences">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <WrapPanel>
                                    <Border Style="{StaticResource CardStyle}" Width="280" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="General" FontSize="17" FontWeight="Bold" Foreground="#17324A" />
                                            <CheckBox Margin="0,10,0,0"
                                                      Content="Smart mode"
                                                      IsChecked="{Binding Settings.SmartModeEnabled}" />
                                            <TextBlock Margin="0,12,0,0" Text="Language" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.Language}" />
                                            <TextBlock Margin="0,4,0,0" Text="Download type" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding DownloadKinds}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.Kind}" />
                                            <TextBlock Margin="0,4,0,0" Text="Quality" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding QualityPresets}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.Quality}" />
                                            <TextBlock Margin="0,4,0,0" Text="Speed limit" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding SpeedLimits}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.SpeedLimit}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Width="280" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="Formats &amp; access" FontSize="17" FontWeight="Bold" Foreground="#17324A" />
                                            <TextBlock Margin="0,10,0,0" Text="Video format" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding VideoFormats}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.VideoFormat}" />
                                            <TextBlock Margin="0,4,0,0" Text="Audio format" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding AudioFormats}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.AudioFormat}" />
                                            <TextBlock Margin="0,4,0,0" Text="Browser cookies" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding CookieSources}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Settings.CookieSource}" />
                                            <CheckBox Margin="0,8,0,0"
                                                      Content="Download subtitles when available"
                                                      IsChecked="{Binding Settings.IncludeSubtitles}" />
                                            <CheckBox Margin="0,6,0,0"
                                                      Content="Download additional audio tracks when available"
                                                      IsChecked="{Binding Settings.IncludeAdditionalAudioTracks}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Width="320" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Paths &amp; runtime" FontSize="17" FontWeight="Bold" Foreground="#17324A" />
                                            <TextBlock Margin="0,10,0,0" Text="Save folder" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0"
                                                     Text="{Binding Settings.SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Margin="0,10,0,0"
                                                    Style="{StaticResource ToolButtonStyle}"
                                                    Content="Choose folder"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding BrowseSaveFolderCommand}" />
                                            <TextBlock Margin="0,10,0,0"
                                                       FontSize="12"
                                                       Foreground="#60758A"
                                                       Text="Runtime tools should be available in windows/runtime/win-x64."
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       FontSize="12"
                                                       Foreground="#60758A"
                                                       Text="{Binding LogFilePath}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
