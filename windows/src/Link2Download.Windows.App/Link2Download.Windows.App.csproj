<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Link2Download.Windows.Core\Link2Download.Windows.Core.csproj" />
    <ProjectReference Include="..\Link2Download.Windows.Infrastructure\Link2Download.Windows.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Link2Download</AssemblyName>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedPortableRuntime)' == 'true' Or '$(Configuration)' == 'Release'">
    <EmbeddedResource Include="..\..\runtime\win-x64\*.exe" LogicalName="BundledRuntime.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
